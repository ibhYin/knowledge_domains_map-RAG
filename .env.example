# OpenAI 兼容端点（用户提供）
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# 结构化输出模式：json_mode | function_calling | json_schema
STRUCTURED_OUTPUT_METHOD=json_mode

# 可选，仅在模型支持 thinking 参数时设置；实体抽取可关闭深度思考
# EXTRACTION_THINKING=disabled

# 分块
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# 建图并发（受端点限流约束）
EXTRACTION_CONCURRENCY=4

# 每处理多少个分块保存一次图谱和成功处理记录
BUILD_CHECKPOINT_INTERVAL=50
